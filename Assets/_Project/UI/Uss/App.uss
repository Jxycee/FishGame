.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; padding: 16px; background-color: rgba(10, 18, 28, 0.85); }
.panel { flex-direction: column; align-items: stretch; width: 92%; max-width: 640px; max-height: 100%; padding: 16px; background-color: rgba(20, 30, 44, 0.96); border-radius: 8px; color: rgb(235, 240, 245); font-size: 16px; }
.panel.tall { height: 92%; }
.row { flex-direction: row; align-items: center; margin: 2px 0; }
.grow { flex-grow: 1; }
.title { font-size: 40px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 0 0 12px 0; color: rgb(235, 240, 245); }
.title.small { font-size: 28px; margin: 0 0 8px 0; }
.section { font-size: 20px; -unity-font-style: bold; margin: 12px 4px 6px 4px; color: rgb(200, 230, 255); }
.centered { -unity-text-align: middle-center; }
.label { font-size: 16px; margin: 8px 4px 0 4px; color: rgb(220, 226, 232); }
.hint { font-size: 14px; margin: 0 4px 6px 4px; color: rgb(170, 180, 190); white-space: normal; }
.spinner { font-size: 28px; -unity-text-align: middle-center; margin: 8px 0; color: rgb(255, 255, 255); }
.menu-button { height: 40px; margin: 4px; font-size: 18px; }
.join-button { width: 160px; flex-shrink: 0; }
.dev-button { flex-grow: 1; flex-basis: 0; font-size: 15px; }
.rebind-button { height: 34px; font-size: 15px; -unity-text-align: middle-left; padding-left: 10px; }
.code-field { flex-grow: 1; min-width: 120px; margin: 4px; }
.setting { margin: 3px 4px; }
.setting .unity-base-field__label { min-width: 220px; font-size: 16px; color: rgb(220, 226, 232); }
.code-field .unity-base-text-field__input, .setting .unity-base-text-field__input { font-size: 18px; min-height: 30px; }
.code-text { font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 4px 0; color: rgb(255, 255, 255); }
.menu-button:focus, .rebind-button:focus, .setting:focus { border-width: 2px; border-color: rgb(255, 210, 90); }
.dim { opacity: 0.5; }
.crosshair { position: absolute; left: 50%; top: 50%; translate: -50% -50%; font-size: 22px; color: rgb(255, 255, 255); }
.hud-prompt { position: absolute; left: 50%; top: 56%; translate: -50% 0; font-size: 18px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.hud-strip { position: absolute; left: 16px; bottom: 16px; font-size: 14px; color: rgb(220, 226, 232); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.toast-stack { position: absolute; right: 16px; bottom: 16px; width: 320px; max-width: 60%; align-items: flex-end; }
.toast { background-color: rgba(20, 30, 44, 0.92); padding: 10px 14px; margin: 4px 0; border-radius: 6px; color: rgb(255, 255, 255); font-size: 16px; max-width: 320px; white-space: normal; }
.nameplate { position: absolute; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; translate: -50% -100%; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
