.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; padding: 16px; background-color: rgba(10, 18, 28, 0.85); }
.panel { flex-direction: column; align-items: stretch; width: 92%; max-width: 640px; max-height: 100%; padding: 16px; background-color: rgba(20, 30, 44, 0.96); border-radius: 8px; color: rgb(235, 240, 245); font-size: 16px; }
.panel.tall { height: 92%; }
.row { flex-direction: row; align-items: center; margin: 2px 0; }
.grow { flex-grow: 1; }
.title { font-size: 40px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 0 0 12px 0; color: rgb(235, 240, 245); }
.title.small { font-size: 28px; margin: 0 0 8px 0; }
.section { font-size: 20px; -unity-font-style: bold; margin: 12px 4px 6px 4px; color: rgb(200, 230, 255); }
.centered { -unity-text-align: middle-center; }
.label { font-size: 16px; margin: 8px 4px 0 4px; color: rgb(220, 226, 232); }
.hint { font-size: 14px; margin: 0 4px 6px 4px; color: rgb(170, 180, 190); white-space: normal; }
.spinner { font-size: 28px; -unity-text-align: middle-center; margin: 8px 0; color: rgb(255, 255, 255); }
.menu-button { height: 40px; margin: 4px; font-size: 18px; }
.join-button { width: 160px; flex-shrink: 0; }
.dev-button { flex-grow: 1; flex-basis: 0; font-size: 15px; }
.rebind-button { height: 34px; font-size: 15px; -unity-text-align: middle-left; padding-left: 10px; }
.code-field { flex-grow: 1; min-width: 120px; margin: 4px; }
.setting { margin: 3px 4px; }
.setting .unity-base-field__label { min-width: 220px; font-size: 16px; color: rgb(220, 226, 232); }
.code-field .unity-base-text-field__input, .setting .unity-base-text-field__input { font-size: 18px; min-height: 30px; }
.code-text { font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 4px 0; color: rgb(255, 255, 255); }
.tab-button { flex-grow: 1; flex-basis: 0; height: 36px; margin: 2px 4px 6px 4px; font-size: 18px; background-color: rgba(40, 56, 76, 0.9); color: rgb(190, 200, 212); }
.tab-button.active { background-color: rgb(52, 112, 170); color: rgb(255, 255, 255); -unity-font-style: bold; }
.menu-button:focus, .rebind-button:focus, .setting:focus, .tab-button:focus { border-width: 2px; border-color: rgb(255, 210, 90); }
.dim { opacity: 0.5; }
.crosshair { position: absolute; left: 50%; top: 50%; translate: -50% -50%; font-size: 22px; color: rgb(255, 255, 255); }
.hud-prompt { position: absolute; left: 50%; top: 56%; translate: -50% 0; font-size: 18px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.hud-strip { position: absolute; left: 16px; bottom: 16px; font-size: 14px; color: rgb(220, 226, 232); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.toast-stack { position: absolute; right: 16px; bottom: 48px; width: 320px; max-width: 60%; align-items: flex-end; }
.toast { background-color: rgba(20, 30, 44, 0.92); padding: 10px 14px; margin: 4px 0; border-radius: 6px; color: rgb(255, 255, 255); font-size: 16px; max-width: 320px; white-space: normal; }
.nameplate { position: absolute; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; translate: -50% -100%; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.fishing-ring { position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; translate: -50% -50%; }
.fishing-gauge { position: absolute; left: 50%; top: 50%; width: 140px; height: 70px; translate: -50% 0; }
.fishing-gauge.bar { width: 160px; height: 12px; margin-top: 42px; }
.fishing-hook { position: absolute; left: 50%; bottom: 120px; translate: -50% 0; font-size: 30px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.fishing-caption { position: absolute; left: 50%; bottom: 72px; translate: -50% 0; font-size: 22px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.fishing-creel { position: absolute; right: 16px; bottom: 16px; font-size: 18px; color: rgb(235, 240, 245); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.fishing-creel.warn { -unity-font-style: bold; color: rgb(255, 200, 70); border-left-width: 3px; border-left-color: rgb(255, 200, 70); padding-left: 6px; }
.fishing-creel.full { -unity-font-style: bold; color: rgb(255, 110, 90); }
.menu-button.half { flex-grow: 1; flex-basis: 0; }
.summary { -unity-text-align: middle-center; font-size: 16px; margin: -6px 4px 8px 4px; color: rgb(200, 230, 255); }
.journal { background-color: rgba(6, 10, 16, 0.78); }
.journal-panel { width: 94%; max-width: 1720px; height: 92%; padding: 22px 28px; border-radius: 12px; }
.journal-header { margin: 0; justify-content: space-between; }
.journal-heading { flex-direction: row; align-items: center; flex-grow: 1; }
.journal-title { font-size: 40px; margin: 0 22px 0 0; -unity-text-align: middle-left; }
.journal-completion { font-size: 26px; margin: 0; color: rgb(200, 230, 255); }
.journal-close { width: 150px; height: 46px; margin: 0; font-size: 22px; background-color: rgb(52, 112, 170); color: rgb(255, 255, 255); border-width: 2px; border-color: rgb(120, 170, 220); border-radius: 8px; }
.journal-close:focus { border-color: rgb(255, 210, 90); }
.journal-progress { height: 10px; margin: 14px 0 16px 0; border-radius: 5px; background-color: rgba(40, 56, 76, 0.9); }
.journal-progress-fill { height: 100%; width: 0; border-radius: 5px; background-color: rgb(120, 200, 255); }
.journal-filters { flex-wrap: wrap; margin: 0 0 12px 0; }
.journal-spot-filters { flex-wrap: wrap; flex-grow: 1; margin: 0; }
.journal-filter { height: 44px; margin: 3px 10px 3px 0; padding: 0 22px; font-size: 21px; border-radius: 22px; border-width: 0; border-bottom-width: 3px; border-bottom-color: rgba(0, 0, 0, 0); background-color: rgba(40, 56, 76, 0.9); color: rgb(205, 214, 224); }
.journal-filter.selected { background-color: rgb(52, 112, 170); color: rgb(255, 255, 255); -unity-font-style: bold; border-bottom-color: rgb(255, 210, 90); }
.journal-filter:focus { border-width: 2px; border-color: rgb(255, 210, 90); }
.journal-filter-biting { margin: 3px 4px; }
.journal-filter-biting .unity-base-field__label { min-width: 0; font-size: 21px; margin-right: 12px; color: rgb(220, 226, 232); }
.journal-grid { flex-direction: row; flex-wrap: wrap; padding: 10px 2px 2px 2px; }
.journal-card { width: 290px; min-height: 270px; margin: 6px; padding: 16px; flex-direction: column; flex-shrink: 0; border-radius: 10px; border-width: 3px; border-color: rgba(0, 0, 0, 0); background-color: rgba(34, 48, 68, 0.95); }
.journal-card:focus { border-color: rgb(255, 210, 90); }
.journal-card.level-0 { background-color: rgba(26, 36, 50, 0.9); }
.journal-plate { height: 116px; margin-bottom: 12px; align-items: center; justify-content: center; border-radius: 8px; background-color: rgba(58, 76, 102, 0.95); }
.journal-icon { width: 224px; height: 112px; }
.journal-badge { position: absolute; right: 12px; top: -10px; padding: 2px 12px; border-radius: 13px; border-width: 2px; border-color: rgb(255, 200, 70); background-color: rgba(60, 44, 10, 0.97); color: rgb(255, 214, 100); font-size: 16px; -unity-font-style: bold; }
.journal-name { font-size: 25px; -unity-font-style: bold; margin: 0 0 6px 0; color: rgb(240, 244, 248); white-space: normal; }
.journal-card.level-0 .journal-name { -unity-font-style: bold-and-italic; color: rgb(150, 162, 176); }
.journal-info { margin: 0; }
.journal-line { font-size: 17px; margin: 0 0 4px 0; color: rgb(208, 216, 226); white-space: normal; }
.journal-card.level-0 .journal-line { color: rgb(140, 152, 166); }
.journal-glyphs { margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.16); }
.journal-caption { font-size: 14px; margin: 0 0 6px 0; color: rgb(160, 174, 190); }
.journal-legend { font-size: 12px; margin: 0 0 6px 0; color: rgb(150, 164, 180); white-space: normal; }
.journal-glyph-row { flex-direction: row; align-items: center; }
.journal-glyph { width: 32px; height: 32px; margin: 0 2px; }
.journal-glyph-gap { width: 16px; }
.journal-band-bar { height: 16px; margin-top: 8px; }
.journal-band-labels { flex-direction: row; }
.journal-band-label { flex-grow: 1; flex-basis: 0; margin: 3px 0 0 0; font-size: 13px; -unity-text-align: upper-center; color: rgb(170, 182, 196); }
.journal-empty { font-size: 24px; margin: 48px 0; -unity-text-align: middle-center; color: rgb(180, 190, 200); }
.dev-overlay { position: absolute; left: 16px; top: 16px; max-width: 46%; padding: 8px; font-size: 13px; white-space: normal; color: rgb(220, 235, 245); background-color: rgba(10, 18, 28, 0.75); -unity-text-align: upper-left; }
