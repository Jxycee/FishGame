<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="NameplateLayer" class="layer" picking-mode="Ignore" />

        <ui:VisualElement name="ScreenHud" class="layer hidden" picking-mode="Ignore">
            <ui:Label name="Crosshair" class="crosshair" text="+" picking-mode="Ignore" />
            <ui:Label name="InteractPrompt" class="hud-prompt" picking-mode="Ignore" />
            <ui:Label name="PromptStrip" class="hud-strip" picking-mode="Ignore" />
            <ui:VisualElement name="FishingChargeRing" class="fishing-ring" picking-mode="Ignore" focusable="false" />
            <ui:VisualElement name="FishingLineGauge" class="fishing-gauge" picking-mode="Ignore" focusable="false" />
            <ui:Label name="FishingHookPrompt" class="fishing-hook" picking-mode="Ignore" focusable="false" />
            <ui:Label name="FishingCaption" class="fishing-caption" picking-mode="Ignore" focusable="false" />
            <ui:Label name="FishingCreel" class="fishing-creel" picking-mode="Ignore" focusable="false" />
            <ui:Label name="DevOverlay" class="dev-overlay hidden" picking-mode="Ignore" focusable="false" />
        </ui:VisualElement>

        <ui:VisualElement name="ScreenMainMenu" class="screen hidden">
            <ui:VisualElement class="panel">
                <ui:Label name="MenuTitle" class="title" />
                <ui:Label name="MetaSummary" class="hint summary" />
                <ui:Button name="HostButton" class="menu-button" />
                <ui:Label name="JoinCodeLabel" class="label" />
                <ui:VisualElement class="row">
                    <ui:TextField name="JoinCodeField" class="code-field" />
                    <ui:Button name="JoinButton" class="menu-button join-button" />
                </ui:VisualElement>
                <ui:Button name="SoloButton" class="menu-button" />
                <ui:VisualElement class="row">
                    <ui:Button name="SettingsButton" class="menu-button half" />
                    <ui:Button name="JournalButton" class="menu-button half" />
                </ui:VisualElement>
                <ui:Button name="QuitButton" class="menu-button" />
                <ui:TextField name="NameField" class="setting" />
                <ui:VisualElement name="DevRow" class="row">
                    <ui:Button name="DevHostButton" class="menu-button dev-button" />
                    <ui:Button name="DevJoinButton" class="menu-button dev-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ScreenBusy" class="screen hidden">
            <ui:VisualElement class="panel">
                <ui:Label name="BusyLabel" class="section centered" />
                <ui:Label name="BusySpinner" class="spinner" />
                <ui:Button name="CancelButton" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ScreenSettings" class="screen hidden">
            <ui:VisualElement class="panel tall">
                <ui:Label name="SettingsTitle" class="title small" />
                <ui:VisualElement name="SettingsTabs" class="row">
                    <ui:Button name="TabGeneral" class="tab-button active" />
                    <ui:Button name="TabGraphics" class="tab-button" />
                </ui:VisualElement>
                <ui:ScrollView name="GraphicsScroll" class="grow hidden">
                    <ui:Label name="SectionScreen" class="section" />
                    <ui:SliderInt name="WindowMode" class="setting" low-value="0" high-value="2" />
                    <ui:SliderInt name="Resolution" class="setting" low-value="0" high-value="0" />
                    <ui:Toggle name="VSync" class="setting" />
                    <ui:SliderInt name="FrameCap" class="setting" low-value="0" high-value="4" />
                    <ui:Label name="SectionQuality" class="section" />
                    <ui:SliderInt name="QualityPreset" class="setting" low-value="0" high-value="3" />
                    <ui:SliderInt name="RenderScale" class="setting" low-value="0" high-value="10" />
                    <ui:SliderInt name="ShadowQuality" class="setting" low-value="0" high-value="2" />
                    <ui:SliderInt name="AntiAliasing" class="setting" low-value="0" high-value="3" />
                    <ui:Label name="GraphicsHint" class="hint" />
                </ui:ScrollView>
                <ui:ScrollView name="SettingsScroll" class="grow">
                    <ui:Label name="SectionDisplay" class="section" />
                    <ui:SliderInt name="UiScale" class="setting" low-value="80" high-value="150" />
                    <ui:Label name="SectionAudio" class="section" />
                    <ui:SliderInt name="MasterVolume" class="setting" low-value="0" high-value="100" />
                    <ui:SliderInt name="EffectsVolume" class="setting" low-value="0" high-value="100" />
                    <ui:SliderInt name="AmbienceVolume" class="setting" low-value="0" high-value="100" />
                    <ui:SliderInt name="InterfaceVolume" class="setting" low-value="0" high-value="100" />
                    <ui:Label name="SectionGameplay" class="section" />
                    <ui:TextField name="SettingsName" class="setting" />
                    <ui:Slider name="MouseSensitivity" class="setting" low-value="0.04" high-value="0.3" />
                    <ui:Slider name="GamepadLookSpeed" class="setting" low-value="0.2" high-value="3" />
                    <ui:Toggle name="InvertY" class="setting" />
                    <ui:SliderInt name="FieldOfView" class="setting" low-value="80" high-value="110" />
                    <ui:Slider name="CameraMotion" class="setting" low-value="0" high-value="1" />
                    <ui:SliderInt name="LineGauge" class="setting" low-value="0" high-value="2" />
                    <ui:Toggle name="Captions" class="setting" />
                    <ui:Toggle name="FishingAssist" class="setting" />
                    <ui:Toggle name="SprintToggle" class="setting" />
                    <ui:Toggle name="AimToggle" class="setting" />
                    <ui:Toggle name="StreamerMode" class="setting" />
                    <ui:Label name="SectionControls" class="section" />
                    <ui:Label name="RebindHint" class="hint" />
                    <ui:VisualElement name="RebindList" />
                    <ui:Button name="RebindReset" class="menu-button" />
                </ui:ScrollView>
                <ui:Button name="SettingsBack" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ScreenPause" class="screen hidden">
            <ui:VisualElement class="panel">
                <ui:Label name="PauseTitle" class="title small" />
                <ui:Button name="ResumeButton" class="menu-button" />
                <ui:Button name="PauseSettingsButton" class="menu-button" />
                <ui:VisualElement name="CodeRow">
                    <ui:Label name="CodeLabel" class="label" />
                    <ui:Label name="CodeText" class="code-text" />
                    <ui:VisualElement class="row">
                        <ui:Button name="CopyButton" class="menu-button dev-button" />
                        <ui:Button name="RevealButton" class="menu-button dev-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="JoinsButton" class="menu-button" />
                <ui:Button name="LeaveButton" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="JournalModal" class="screen journal hidden">
            <ui:VisualElement name="JournalPanel" class="panel journal-panel">
                <ui:VisualElement class="row journal-header">
                    <ui:VisualElement class="journal-heading">
                        <ui:Label name="JournalTitle" class="title small journal-title" />
                        <ui:Label name="JournalCompletion" class="label journal-completion" />
                    </ui:VisualElement>
                    <ui:Button name="JournalClose" class="menu-button journal-close" />
                </ui:VisualElement>
                <ui:VisualElement name="JournalProgress" class="journal-progress">
                    <ui:VisualElement name="JournalProgressFill" class="journal-progress-fill" />
                </ui:VisualElement>
                <ui:VisualElement name="JournalFilters" class="row journal-filters">
                    <ui:Button name="JournalFilterAll" class="journal-filter" />
                    <ui:VisualElement name="JournalSpotFilters" class="row journal-spot-filters" />
                    <ui:Toggle name="JournalFilterBiting" class="setting journal-filter-biting" />
                </ui:VisualElement>
                <ui:ScrollView name="JournalScroll" class="grow">
                    <ui:VisualElement name="JournalGrid" class="journal-grid" />
                    <ui:Label name="JournalEmpty" class="journal-empty hidden" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ToastStack" class="toast-stack" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
